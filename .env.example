# Base des URL canoniques, du sitemap et des balises Open Graph.
# À définir avant toute mise en ligne : sans elle, les canonicals pointent
# vers le domaine par défaut du code.
NEXT_PUBLIC_SITE_URL=https://moonfish.fish

# ── Aucune des clés ci-dessous n'est lue par cette version. ──
# Elles sont listées pour que le branchement des vrais fournisseurs
# (voir README, « Comment remplacer les mocks ») parte d'une base connue.
# STORMGLASS_API_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
